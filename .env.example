# ===============================================
# Environment Configuration Template
# ===============================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/restaurant_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000
REFRESH_TOKEN_EXPIRATION=604800000

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Environment
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080/ws

# ===============================================
# Payment Gateway Configuration
# ===============================================
DEFAULT_PAYMENT_GATEWAY=STRIPE

# Stripe Test Keys (Get from Stripe Dashboard -> Developers -> API Keys)
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
# Stripe Webhook Secret (From Stripe CLI: `stripe listen --forward-to localhost:8080/api/payments/webhook/stripe`)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_CURRENCY=sgd
STRIPE_SUCCESS_URL=http://localhost:5173/billing/stripe-return?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/billing?status=cancelled

# Razorpay Test Keys (Get from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
RAZORPAY_CURRENCY=INR
